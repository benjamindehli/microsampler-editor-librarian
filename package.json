{
    "name": "microsampler-editor-librarian",
    "version": "1.17.2",
    "private": true,
    "type": "module",
    "description": "Build tooling for the microSAMPLER Editor / Librarian web app (the app itself has no runtime npm dependencies).",
    "license": "GPL-3.0-or-later",
    "author": "Benjamin Dehli <superelg@gmail.com>",
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "scripts": {
        "build": "node tools/build.mjs",
        "pack": "node tools/build.mjs && node tools/pack.mjs",
        "lint:js": "eslint src/web-editor",
        "lint:types": "tsc -p tsconfig.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node --import ./test/unit/alias-register.mjs --test test/unit/*.test.mjs",
        "stamp-version": "node tools/stamp-docs-version.mjs",
        "stamp-dates": "node tools/stamp-docs-dates.mjs",
        "version": "node tools/stamp-docs-version.mjs && node tools/stamp-docs-dates.mjs && git add docs/*.html docs/sitemap.xml src/native-tools/bridge.py CITATION.cff"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.9.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.11.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "brace-expansion": "^5.0.7"
    }
}
